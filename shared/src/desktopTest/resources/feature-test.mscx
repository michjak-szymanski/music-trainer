      </Measure>
      <!-- Clef change to treble mid-bar -->
      <Measure>
        <voice>
          <Chord><durationType>quarter</durationType><Note><pitch>45</pitch><tpc>17</tpc></Note></Chord>
          <Clef><concertClefType>G</concertClefType></Clef>
